# ──────────────────────────────────────────────────────────
# HIDAYA ONE API — Environment Template
# Copy to .env — never commit .env to git.
# ──────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# ADK agent service URL (private Cloud Run — no public access)
# In Cloud Run, populated via Secret Manager or env var binding
ADK_SERVICE_URL=https://hidaya-one-agent-api-440186659444.asia-south1.run.app

# YouTube Data API (read-only public data)
YOUTUBE_API_KEY=your-youtube-api-key-here

# Google Cloud project (used by google-auth-library for ADC)
GOOGLE_CLOUD_PROJECT=even-boulder-514217-d5
GOOGLE_CLOUD_LOCATION=asia-south1

