# ──────────────────────────────────────────────────────────
# HIDAYA ONE — Environment Configuration Template
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────

# ── Option A: Google AI Studio (Gemini Developer API) ────
# Get your key from https://aistudio.google.com/apikey
# GOOGLE_GENAI_API_KEY=your-api-key-here

# ── Option B: Google Cloud / Vertex AI ───────────────────
# Requires: gcloud auth application-default login
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ── Hidaya One Settings ──────────────────────────────────
# Model override (default: gemini-3.8-flash)
# HIDAYA_MODEL=gemini-3.8-flash

# Operating mode: DEVELOPMENT | STAGING | PRODUCTION
# HIDAYA_MODE=DEVELOPMENT
