# ──────────────────────────────────────────────────────────
# HIDAYA ONE — Environment Configuration Template
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────

# ── Option A: Google AI Studio (Gemini Developer API) ────
# Get your key from https://aistudio.google.com/apikey
# GOOGLE_GENAI_API_KEY=your-api-key-here

# ── Option B: Google Cloud / Vertex AI ───────────────────
# Requires: gcloud auth application-default login
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=your-project-id
#
# Region. GOOGLE_CLOUD_LOCATION is the single authoritative region setting:
# the ADK reads it directly and nothing in this repository overrides it.
# This is the model location, not the Cloud Run region (which stays
# asia-south1). Tested 2026-11-17: gemini-3.8-flash answers only at `global`
# for this project; asia-south1, us-central1 and asia-southeast1 return 404.
# GOOGLE_CLOUD_LOCATION=global

# ── Hidaya One Settings ──────────────────────────────────
# Model override (default: gemini-3.8-flash)
# HIDAYA_MODEL=gemini-3.8-flash

# Operating mode: DEVELOPMENT | STAGING | PRODUCTION
# HIDAYA_MODE=DEVELOPMENT

# Deadline for each model call, in milliseconds (10000–600000, default
# 180000). The Gemini SDK has none of its own: without it a stalled call waits
# for the server's 10-minute limit. An invalid value stops the service at start.
# HIDAYA_MODEL_TIMEOUT_MS=180000

# ── Religious validation gate ────────────────────────────
# Secret used to sign gate attestations (32+ characters). Without it the
# gate passes nothing. Generate with: openssl rand -hex 32
# In Cloud Run this must come from Secret Manager, never from a file.
# HIDAYA_GATE_ATTESTATION_KEY=
